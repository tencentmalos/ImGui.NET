<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:AvaloniaImGuiExample"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaImGuiExample.ucImGui">
	<Grid>
	    <local:ucNativeImGui Name="_nativeControl" Focusable="True"/>
		<!--For add valid hit test here, by default OpenGlControlBase can ignore input here.-->
		<Panel Background="Transparent" IsHitTestVisible="True" Opacity="0"></Panel>
	</Grid>
</UserControl>
